load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "rustlib",
    srcs = glob(["**/*.rs"]),
    #    crate_type = "staticlib",
    crate_name = "rustlib",
    edition = "2021",
    rustc_flags = [
        "--crate-type=staticlib",
    ],
    visibility = ["//rust_demo/main:__pkg__"],
    deps = [
        "@my_crates//:rand",
        "@my_crates//:serde",
        "@my_crates//:tempfile",
    ],
)
